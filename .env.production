# =============================================
# SakuraPay Payment Gateway — PRODUCTION
# =============================================
# ⚠️ SET THESE IN VERCEL ENVIRONMENT VARIABLES (NOT in this file!)
#    Dashboard SakuraPay → Pengaturan → API & Kunci Akses
# SAKURA_API_ID=your_production_api_id
# SAKURA_API_KEY=your_production_api_key
SAKURA_ENV=production
SAKURA_CALLBACK_URL=https://luxtradee.web.id/api/payment/callback
