# ══════════════════════════════════════════════════════════════════════════════
# LuxTradee CI Environment — for Capacitor Android/iOS builds
# ══════════════════════════════════════════════════════════════════════════════
# This file provides env vars for GitHub Actions builds.
# It contains ONLY NEXT_PUBLIC_* vars (safe to commit — they are client-exposed
# and already present in wrangler.toml [vars] which is also committed).
#
# Server-side secrets are NOT needed for static export builds because:
# - `output: 'export'` pre-renders pages at build time (no API routes)
# - The Capacitor app calls the production API at luxtradee.web.id at runtime
# - API route handlers are not included in the static export
# ══════════════════════════════════════════════════════════════════════════════

# ─── Supabase (client-side, anon key — public, read-only) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://klxkdrfsfcoankbaoejn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtseGtkcmZzZmNvYW5rYmFvZWpuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzAzNzY0MTAsImV4cCI6MjA4NTk1MjQxMH0.4Yv9JesMXWEy4phu2D-Yw9rkbq0l8z9kz-sRwFZerQ0

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://luxtradee.web.id
NEXT_PUBLIC_SITE_URL=https://luxtradee.web.id

# ─── Payment URLs (Skrill — public checkout pages) ────────────────────────────
NEXT_PUBLIC_SKRILL_LIFETIME_URL=https://www.skrill.com/en/
NEXT_PUBLIC_SKRILL_PRO_URL=https://www.skrill.com/en/

# ─── Push Notification VAPID Public Key (client-side, safe to expose) ────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Database (SQLite for Prisma client generation, not used at runtime) ──────
DATABASE_URL=file:./db/custom.db

# ─── Midtrans (public flag only — server key is a Cloudflare Worker secret) ───
MIDTRANS_IS_PRODUCTION=true
