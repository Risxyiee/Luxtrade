{
        "$schema": "node_modules/wrangler/config-schema.json",

        // ══════════════════════════════════════════════════════════════════════════
        // SINGLE SOURCE OF TRUTH
        // wrangler.toml has been REMOVED. Having two config files caused a
        // production incident: deploys used THIS file, which silently wiped
        // dashboard plain-text vars (Supabase URL/service key) and dropped the
        // KV/AI/Images/Browser/Queue bindings that only existed in the toml.
        //
        // Deploy order (manual):  bun run build && npx wrangler deploy
        //   (build generates .open-next/worker.js which worker-entry.ts imports)
        //
        // SECRETS ARE NEVER DECLARED HERE. Set via:
        //   npx wrangler secret put <NAME>     (or dashboard -> Variables -> Encrypt)
        // keep_vars=true additionally preserves any dashboard-defined plain vars.
        // ══════════════════════════════════════════════════════════════════════════

        "name": "luxtradee",

        // Custom entrypoint: wraps .open-next/worker.js + scheduled() cron handler
        "main": "worker-entry.ts",
        "compatibility_date": "2025-07-18",
        "compatibility_flags": ["nodejs_compat", "streams_enable_constructors"],

        // Never delete dashboard-defined env vars that are not listed below
        "keep_vars": true,

        "assets": {
                "directory": ".open-next/assets",
                "binding": "ASSETS"
        },

        // ─── Cloudflare Bindings ────────────────────────────────────────────────
        "kv_namespaces": [
                { "binding": "luxtradee_kv", "id": "4d16786ba51a4c22b42b1af7b97e3bd6" }
        ],
        "images": { "binding": "IMAGES" },
        "ai": { "binding": "ai_luxtrade" },
        "browser": { "binding": "ai_run" },
        "queues": {
                "producers": [{ "binding": "queue", "queue": "luxtradee" }]
        },
        // R2 disabled (error 10042, not provisioned) — re-enable when provisioned:
        // "r2_buckets": [{ "binding": "R2", "bucket_name": "luxtradee-uploads" }],

        // ─── Plain-text vars (public / client-safe values ONLY) ─────────────────
        // Supabase anon key is public by design (RLS-protected, ships to browsers).
        "vars": {
                "NEXT_PUBLIC_SUPABASE_URL": "https://klxkdrfsfcoankbaoejn.supabase.co",
                "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtseGtkcmZzZmNvYW5rYmFvZWpuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzAzNzY0MTAsImV4cCI6MjA4NTk1MjQxMH0.4Yv9JesMXWEy4phu2D-Yw9rkbq0l8z9kz-sRwFZerQ0",

                "NEXT_PUBLIC_SITE_URL": "https://luxtradee.web.id",
                "NEXT_PUBLIC_APP_URL": "https://luxtradee.web.id",
                "NEXT_PUBLIC_BASE_URL": "https://luxtradee.web.id",

                "NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BNTL6FFlfUygscRgM-1grOaHx57xsGDB2Vad_rZ1oOdeW6rLtrCLqr8AOcZf5Cp0gC5cobm8NvfvCpIV5QUHCYI",
                "VAPID_SUBJECT": "mailto:support@luxtradee.web.id",

                "NEXT_PUBLIC_SKRILL_PRO_URL": "https://www.skrill.com/en/",
                "NEXT_PUBLIC_SKRILL_LIFETIME_URL": "https://www.skrill.com/en/",

                "MIDTRANS_IS_PRODUCTION": "true"
        },

        // ─── Workers Observability (logs + traces in CF dashboard) ───────────────
        "observability": {
                "enabled": true,
                "head_sampling_rate": 1,
                "logs": {
                        "enabled": true,
                        "head_sampling_rate": 1,
                        "invocation_logs": true,
                        "persist": true
                },
                "traces": {
                        "enabled": true,
                        "head_sampling_rate": 1,
                        "persist": true
                }
        },

        // ─── Cron triggers → worker-entry.ts scheduled() → /api/cron/* ──────────
        // NOTE: Workers Free plan = max 5 crons. AI agents consolidated into
        // existing daily/weekly schedules (they just queue drafts for approval).
        // 0 1 * * *  = 08:00 WIB harian  (daily-reminder + downgrade-expired-pro + ai-cs-agent)
        // 0 3 * * *  = 10:00 WIB harian  (re-engage + downgrade-expired-pro)
        // 0 3 * * 1  = Senin 10:00 WIB   (weekly-summary + ai-marketing-agent)
        // */15 * * * = tiap 15 menit     (econ-calendar-notify)
        "triggers": {
                "crons": ["0 1 * * *", "0 3 * * *", "0 3 * * 1", "*/15 * * * *"]
        }
}
