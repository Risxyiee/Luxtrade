{
        "$schema": "node_modules/wrangler/config-schema.json",

        // ══════════════════════════════════════════════════════════════════════════
        // SINGLE SOURCE OF TRUTH
        // wrangler.toml has been REMOVED. Having two config files caused a
        // production incident: deploys used THIS file, which silently wiped
        // dashboard plain-text vars (Supabase URL/service key) and dropped the
        // KV/AI/Images/Browser/Queue bindings that only existed in the toml.
        //
        // Deploy order (manual):  bun run build && npx wrangler deploy
        //   (build generates .open-next/worker.js which worker-entry.ts imports)
        //
        // SECRETS ARE NEVER DECLARED HERE. Set via:
        //   npx wrangler secret put <NAME>     (or dashboard -> Variables -> Encrypt)
        // keep_vars=true additionally preserves any dashboard-defined plain vars.
        // ══════════════════════════════════════════════════════════════════════════

        "name": "luxtradee",

        // Custom entrypoint: wraps .open-next/worker.js + scheduled() cron handler
        "main": "worker-entry.ts",
        "compatibility_date": "2025-07-18",
        "compatibility_flags": ["nodejs_compat", "streams_enable_constructors"],

        // Never delete dashboard-defined env vars that are not listed below
        "keep_vars": true,

        "assets": {
                "directory": ".open-next/assets",
                "binding": "ASSETS"
        },

        // ─── Cloudflare Bindings ────────────────────────────────────────────────
        "kv_namespaces": [
                { "binding": "luxtradee_kv", "id": "4d16786ba51a4c22b42b1af7b97e3bd6" }
        ],
        "images": { "binding": "IMAGES" },
        "ai": { "binding": "ai_luxtrade" },
        "browser": { "binding": "ai_run" },

        // ─── Self Service Binding ──────────────────────────────────────────────
        // Worker memanggil dirinya sendiri (probe keamanan Raka, health-check
        // internal) TANPA lewat edge/DNS publik. Alasan: fetch ke custom domain
        // sendiri dari DALAM worker terbukti 522 (edge gagal tembus origin).
        // Akses kode: getSelfFetch() di src/lib/cloudflare-bindings.ts
        "services": [
                { "binding": "SELF", "service": "luxtradee" }
        ],

        // ─── Cloudflare Flagship (feature flags native Workers) ────────────────
        // Evaluasi flag yang didefinisikan di CF dashboard (Flagship → app
        // f60370a9…) langsung dari kode Worker, tanpa API call eksternal.
        // Akses kode: env.luxtradee → helper di src/lib/cloudflare-bindings.ts
        // (isFlagEnabled / getFlagString / getFlagNumber / getFlagObject).
        // Diagnostik produksi: GET /api/flags/status
        // JANGAN DIHAPUS — binding ini juga dibuat manual di dashboard;
        // kalau hilang dari file ini, wrangler deploy akan menghapusnya di CF.
        "flagship": [
                { "binding": "luxtradee", "app_id": "f60370a9-2d76-40e7-b383-cb966ab5fbd9" }
        ],
        "queues": {
                "producers": [{ "binding": "queue", "queue": "luxtradee" }]
        },
        // R2 disabled (error 10042, not provisioned) — re-enable when provisioned:
        // "r2_buckets": [{ "binding": "R2", "bucket_name": "luxtradee-uploads" }],

        // ─── Plain-text vars (public / client-safe values ONLY) ─────────────────
        // Supabase anon key is public by design (RLS-protected, ships to browsers).
        "vars": {
                "NEXT_PUBLIC_SUPABASE_URL": "https://klxkdrfsfcoankbaoejn.supabase.co",
                "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_gYf7ekooCy36EmIv8_PKzw_ixj0zKhE",

                "NEXT_PUBLIC_SITE_URL": "https://luxtradee.web.id",
                "NEXT_PUBLIC_APP_URL": "https://luxtradee.web.id",
                "NEXT_PUBLIC_BASE_URL": "https://luxtradee.web.id",

                "NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BNTL6FFlfUygscRgM-1grOaHx57xsGDB2Vad_rZ1oOdeW6rLtrCLqr8AOcZf5Cp0gC5cobm8NvfvCpIV5QUHCYI",
                "VAPID_SUBJECT": "mailto:support@luxtradee.web.id",

                "MIDTRANS_IS_PRODUCTION": "true"
        },

        // ─── Workers Observability (logs + traces in CF dashboard) ───────────────
        "observability": {
                "enabled": true,
                "head_sampling_rate": 1,
                "logs": {
                        "enabled": true,
                        "head_sampling_rate": 1,
                        "invocation_logs": true,
                        "persist": true
                },
                "traces": {
                        "enabled": true,
                        "head_sampling_rate": 1,
                        "persist": true
                }
        },

        // ─── Cron triggers → worker-entry.ts scheduled() → /api/cron/* ──────────
        // NOTE: Workers Free plan = max 5 crons. AI agents consolidated into
        // existing daily/weekly schedules (they just queue drafts for approval).
        // 0 1 * * *  = 08:00 WIB harian  (daily-reminder + downgrade-expired-pro + ai-cs-agent + ceo briefing + AUTO-ACC)
        // 0 3 * * *  = 10:00 WIB harian  (re-engage + downgrade-expired-pro)
        // 0 3 * * 1  = Senin 10:00 WIB   (weekly-summary + ai-marketing-agent + ceo weekly report)
        // */5 * * *  = tiap 5 menit      (strategy-alerts TIAP 5 MENIT — permintaan
        //            Bos "15 menit kelamaan"; econ/watchdog/price-alerts tetap
        //            15 menit via EVERY_MIN di worker-entry.ts — TANPA slot baru,
        //            ganti isi slot */15 lama, tetap 4 trigger total)
        "triggers": {
                // SLOT MENIT DIBATALKAN (log build CF 8 Nov 06:54 — error 10072):
                // "This account has reached the Workers Free limit of 5 cron
                // triggers per account" → akun sudah penuh, cron * * * * *
                // DITOLAK CF dan bikin SELURUH deploy gagal. Solusi 11 Nov:
                // slot */15 DIUBAH jadi */5 (jumlah trigger TETAP 4 — bukan
                // nambah), tiap rute atur cadensanya sendiri via EVERY_MIN.
                // Mau tick per-menit beneran → upgrade Workers Paid (Durable
                // Objects alarms) ATAU hapus cron lain.
                "crons": ["0 1 * * *", "0 3 * * *", "0 3 * * 1", "*/5 * * * *"]
        }
}
