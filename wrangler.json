{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "luxtrade",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": ["nodejs_compat", "streams_enable_constructors"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "Kv_luxtr",
      "id": "4d16786ba51a4c22b42b1af7b97e3bd6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "luxtradee-uploads"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "Queue",
        "queue": "luxtradee"
      }
    ]
  },
  "browser": {
    "binding": "Run_ai"
  },
  "ai": {
    "binding": "worked_ai"
  },
  "images": {
    "binding": "IMAGES"
  },
  "limits": {
    "cpu_ms": 30000
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://klxkdrfsfcoankbaoejn.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "REDACTED-DEAD-KEY",
    "NEXT_PUBLIC_SITE_URL": "https://luxtradee.web.id",
    "MIDTRANS_IS_PRODUCTION": "true"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "triggers": {
    "crons": [
      "0 1 * * *",
      "0 3 * * *",
      "0 3 * * 1"
    ]
  }
}
