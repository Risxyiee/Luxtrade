# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# opennext (build output — regenerated by `opennextjs-cloudflare build`)
.open-next/


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
prompt

server.log

# Upload folder (user uploads — should never be in git)
upload/

# Database files
*.db
*.sqlite
*.sqlite3

# Skills directory (AI coding agent tools, not part of the app)
skills/
tool-results/

# Root-level test/debug scripts (not part of the official test suite)
/test-*.js
/test-*.mjs
/check-*.js

# Root-level screenshot files (debug/testing artifacts)
/screenshot-*.png
/signup-page.png

# Root-level loose SQL files (use Prisma migrations instead)
/*.sql

# AI agent data dumps (not part of the app)
funderblu.json
sakura-docs.json