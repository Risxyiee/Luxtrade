# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend Email (for sending confirmation/reset password emails)
RESEND_API_KEY=re_xxxxxxxxxxxx

# MetaApi Configuration
METAAPI_TOKEN=your_metaapi_token_here

# ZAI SDK (for AI features)
ZAI_BASE_URL=https://your-zai-gateway-url
ZAI_API_KEY=your-zai-api-key
ZAI_CHAT_ID=your-chat-id
ZAI_TOKEN=your-zai-token
ZAI_USER_ID=your-user-id

# Database (for local development)
DATABASE_URL=file:./db/custom.db

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://luxtradee.web.id
