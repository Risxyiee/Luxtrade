# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend Email (for sending confirmation/reset password emails)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Resend Template IDs (buat template di Resend Dashboard, paste HTML dari resend-templates/ folder)
RESEND_TEMPLATE_CONFIRM=your_template_id_here
RESEND_TEMPLATE_RESET=your_template_id_here

# CATATAN (2025-11): METAAPI_TOKEN & HUGGING_FACE_API_TOKEN DI-RETIRE.
# Integrasi MetaApi dihapus (lib + route), token HF tidak pernah dipakai kode.
# Jangan tambahkan lagi keduanya di sini maupun di Cloudflare secrets.

# Z.ai Vision SDK (Required for build - uses environment variables in production)
ZAI_BASE_URL=https://internal-api.z.ai/v1
ZAI_API_KEY=your_zai_api_key_here
ZAI_CHAT_ID=your_chat_id_here
ZAI_USER_ID=your_user_id_here
ZAI_TOKEN=your_zai_token_here

# OpenAI API (for Vision AI features - fallback)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API (Primary Vision AI for screenshot trade extraction)
# Get your FREE API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API (Fallback Vision AI — free tier)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here

# Database (for local development)
DATABASE_URL=file:./db/custom.db

# Midtrans Payment Gateway
# Sandbox: SB-Mid-server-XXXXX / SB-Mid-client-XXXXX
# Production: Mid-server-XXXXX / Mid-client-XXXXX
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_IS_PRODUCTION=false

# Finnhub API (FREE tier: 60 calls/min) — Primary for Economic Calendar & News fallback
# Get your FREE API key from: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# RapidAPI - Trading Economics News (free tier: 500 req/month) — Primary for News & Calendar fallback
# Get from: https://rapidapi.com/apihood/api/trading-econmics-scraper
RAPIDAPI_TRADING_ECONOMICS_KEY=your_rapidapi_key_here
# Or use a generic RapidAPI key (checked as fallback):
RAPIDAPI_KEY=your_rapidapi_key_here

# Push Notifications (VAPID Keys)
# Generate keys: node -e "const k=require('web-push').generateVAPIDKeys();console.log('Public:',k.publicKey);console.log('Private:',k.privateKey)"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@luxtradee.web.id

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://luxtradee.web.id

# ── Instagram Auto-Post (Facebook Page Graph API v19.0) ──
# Posting otomatis: POST /{page-id}/media?image_url=&caption= → media_publish.
# PAGE_ID = ID Facebook Page yang terhubung akun Instagram profesional.
# TOKEN   = Page Access Token (Bearer).Produksi: set di CF dashboard secrets
#           (JANGAN [vars] wrangler). Token hasil refresh runtime disimpan
#           di tabel Supabase ig_token_state (dibaca lebih dulu dari env).
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_TOKEN=your_facebook_page_token_here
# Refresh token 60 hari (fb_exchange_token) — wajib untuk auto-refresh:
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
# Baseline usia token: epoch ms / ISO date saat token diterbitkan (opsional):
FACEBOOK_TOKEN_ISSUED_AT=your_token_issued_at_here
