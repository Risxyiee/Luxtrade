# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend Email (for sending confirmation/reset password emails)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Resend Template IDs (buat template di Resend Dashboard, paste HTML dari resend-templates/ folder)
RESEND_TEMPLATE_CONFIRM=your_template_id_here
RESEND_TEMPLATE_RESET=your_template_id_here

# MetaApi Configuration
METAAPI_TOKEN=your_metaapi_token_here

# Z.ai Vision SDK (Required for build - uses environment variables in production)
ZAI_BASE_URL=https://internal-api.z.ai/v1
ZAI_API_KEY=your_zai_api_key_here
ZAI_CHAT_ID=your_chat_id_here
ZAI_USER_ID=your_user_id_here
ZAI_TOKEN=your_zai_token_here

# OpenAI API (for Vision AI features - fallback)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API (Primary Vision AI for screenshot trade extraction)
# Get your FREE API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API (Fallback Vision AI — free tier)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here

# Hugging Face API (for FREE Vision AI features - primary)
# Get your FREE API token from: https://huggingface.co/settings/tokens
HUGGING_FACE_API_TOKEN=hf_your-huggingface-token-here

# Database (for local development)
DATABASE_URL=file:./db/custom.db

# SakuraPay Payment Gateway
# Sandbox: SAKURA_API_ID=SANBOX-xxxxx  SAKURA_API_KEY=SANBOX-xxxxx  SAKURA_ENV=sandbox
# Production: SAKURA_API_ID=PROD-xxxxx  SAKURA_API_KEY=PROD-xxxxx  SAKURA_ENV=production
SAKURA_API_ID=your_sakura_api_id_here
SAKURA_API_KEY=your_sakura_api_key_here
SAKURA_ENV=sandbox
SAKURA_CALLBACK_URL=https://luxtradee.web.id/api/payment/callback
SAKURA_RETURN_URL=https://luxtradee.web.id/upgrade
# ⚠️ NEVER set SAKURA_SKIP_SIGNATURE=true in production (only for sandbox debugging)
# SAKURA_SKIP_SIGNATURE=true

# RapidAPI - Trading Economics News (free tier: 500 req/month)
# Get from: https://rapidapi.com/apihood/api/trading-econmics-scraper
RAPIDAPI_TRADING_ECONOMICS_KEY=your_rapidapi_key_here

# Sentry Error Tracking
# DSN from: https://luxtradee.sentry.io/settings/projects/sentry-emerald-river/keys/
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
# Auth token from: https://luxtradee.sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://luxtradee.web.id
