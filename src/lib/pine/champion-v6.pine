//@version=5
// ============================================================================
//  CHAMPION XAUUSD H1 - v6 FINAL — EDISI WEBSITE (port dari script asli Bos)
// ============================================================================
//  Script ini = champion-v6-original.pine (resep asli Bos) DITAMBAH:
//   1. alert() berformat JSON di setiap titik keputusan order — saluran event
//      standar website (PLACE_LIMIT/REPLACE_LIMIT/CANCEL_PENDING/CLOSE_POSITION)
//      yang identik dengan champion-signal.js (Uji A: parity 13 skenario × 3000
//      candle, 0 selisih).
//   2. plot ADX/DI+/DI- untuk pane indikator di chart website.
//  Logika keputusan, urutan manajemen order, dan input SAMA dengan script asli.
//  Perbedaan kecil yang disengaja (alasan teknis, tidak mengubah keputusan):
//   - fractal pakai loop manual (aturan tie kiri-strict/kanan-non-strict) agar
//     persis engine champion-signal.js; ta.pivothigh memakai tie kebalikannya
//     (kiri non-strict/kanan strict) — terukur 0 bar sinyal berubah di 15.000 bar.
//   - re-entry dengan id sama saat pending: strategy.cancel() dulu (quirk
//     broker PineTS Q2: re-call entry id sama membuat order hilang; di
//     TradingView tidak perlu).
// ============================================================================

strategy("Champion XAUUSD H1 - Final v6", shorttitle="Champion v6", overlay=true, initial_capital=10000, currency=currency.USD, default_qty_type=strategy.fixed, default_qty_value=7, commission_type=strategy.commission.cash_per_order, commission_value=0.035, slippage=3, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=false)

// ---------- INPUT (judul & default SAMA dengan script asli Bos) ----------
// tambahan khusus website (identitas event JSON):
strategyName = input.string("ChampionXAUUSD_H1_v6", "strategyName (event website)")
symbolName   = input.string("XAUUSD", "symbol (event website)")
tfName       = input.string("H1", "timeframe (event website)")

grpS = "Sinyal"
bodyMin    = input.float(83.0, "Body minimal (% dari range)", minval=0.0, maxval=100.0, step=1.0, group=grpS)
adxLen     = input.int(10, "ADX DI Length", minval=1, group=grpS)
adxSmooth  = input.int(14, "ADX Smoothing (Wilder)", minval=1, group=grpS)
adxMin     = input.float(17.0, "ADX minimal", minval=1.0, step=0.5, group=grpS)
allowLong  = input.bool(true, "Aktifkan BUY", group=grpS)
allowShort = input.bool(false, "Aktifkan SELL", group=grpS)

grpF = "Fractal"
useFractal = input.bool(true, "Breakout harus tembus fractal", group=grpF)
frLen      = input.int(3, "Panjang fractal (bar kiri = kanan)", minval=1, group=grpF)

grpR = "Entry Retest"
retestMode = input.string("Close sinyal", "Level retest", options=["Open sinyal", "50% sinyal", "Close sinyal"], group=grpR)
retestBars = input.int(9, "Maks bar nunggu retest", minval=1, maxval=50, group=grpR)

grpT = "Trading"
slUsd    = input.float(20.0, "Stop Loss (USD)", minval=0.1, step=0.5, group=grpT)
tpUsd    = input.float(40.0, "Take Profit (USD)", minval=0.1, step=0.5, group=grpT)
qtyOz    = input.float(7.0, "Qty posisi (7 oz = lot 0.07)", minval=0.01, step=0.01, group=grpT)
sessStr  = input.session("0730-2200", "Sesi trading (WIB)", group=grpT)
endSess  = input.bool(false, "Tutup paksa posisi di akhir sesi", group=grpT)

// ---------- SESI (WIB) — implementasi sama dengan script asli ----------
inSess = not na(time(timeframe.period, sessStr, "Asia/Jakarta"))

// ---------- HELPERS ----------
f_round2(x) => math.round(x * 100) / 100.0
f_numOrNull(x) => na(x) ? "null" : str.tostring(math.round(x * 100) / 100.0)

// ---------- INDIKATOR ----------
[diPlusV, diMinusV, adxV] = ta.dmi(adxLen, adxSmooth)

// fractal: loop manual dengan aturan tie yang SAMA dengan engine
// champion-signal.js (kiri strict >, kanan non-strict >=) — bukan ta.pivothigh
var highs = array.new_float(0)
var lows  = array.new_float(0)
array.push(highs, high)
array.push(lows, low)
if array.size(highs) > 30
    array.shift(highs)
    array.shift(lows)

var float lastPH = na
var float lastPL = na
hn = array.size(highs)
if hn >= 2 * frLen + 1
    ci = hn - 1 - frLen
    centerH = array.get(highs, ci)
    centerL = array.get(lows, ci)
    isH = true
    isL = true
    for i = 1 to frLen
        leftH  = array.get(highs, ci - i)
        rightH = array.get(highs, ci + i)
        leftL  = array.get(lows, ci - i)
        rightL = array.get(lows, ci + i)
        if not (centerH > leftH) or not (centerH >= rightH)
            isH := false
        if not (centerL < leftL) or not (centerL <= rightL)
            isL := false
    if isH
        lastPH := centerH
    if isL
        lastPL := centerL

rng     = high - low
bodyPct = rng > 0 ? math.abs(close - open) / rng * 100.0 : 0.0

bodyOk = bodyPct >= bodyMin
adxOk  = adxV >= adxMin
brkUp  = close > math.max(high[1], high[2])
brkDn  = close < math.min(low[1], low[2])
fracUp = (not useFractal) or na(lastPH) or (close > lastPH)
fracDn = (not useFractal) or na(lastPL) or (close < lastPL)
diUp   = diPlusV > diMinusV
diDn   = diMinusV > diPlusV

longSig  = allowLong and (close > open) and brkUp and bodyOk and adxOk and diUp and fracUp and inSess
shortSig = allowShort and (close < open) and brkDn and bodyOk and adxOk and diDn and fracDn and inSess

// level retest dari candle sinyal
lvlRetest = retestMode == "Open sinyal" ? open : retestMode == "50% sinyal" ? (open + close) / 2 : close

// ---------- STATE ORDER PENDING ----------
flat = strategy.position_size == 0
var int   pendDir = 0
var int   pendBar = 0
var float pendLvl = na

// bersihkan status kalau posisi udah kebuka
if strategy.position_size != 0
    pendDir := 0

// kedaluwarsa: pending gak keisi dalam retestBars bar -> batalin + event
if pendDir != 0 and (bar_index - pendBar) >= retestBars
    alert('{"event":"CANCEL_PENDING","strategy":"' + strategyName + '","symbol":"' + symbolName + '","timeframe":"' + tfName + '","candleTime":' + str.tostring(time) + ',"reason":"EXPIRED","side":"' + (pendDir == 1 ? "BUY" : "SELL") + '","orderRef":"' + strategyName + ':' + (pendDir == 1 ? "ChampLong" : "ChampShort") + '"}', alert.freq_once_per_bar_close)
    strategy.cancel(pendDir == 1 ? "ChampLong" : "ChampShort")
    pendDir := 0
    pendLvl := na

// keluar sesi -> pending dibatalin + event
if (not inSess) and pendDir != 0
    alert('{"event":"CANCEL_PENDING","strategy":"' + strategyName + '","symbol":"' + symbolName + '","timeframe":"' + tfName + '","candleTime":' + str.tostring(time) + ',"reason":"OUT_OF_SESSION","side":"' + (pendDir == 1 ? "BUY" : "SELL") + '","orderRef":"' + strategyName + ':' + (pendDir == 1 ? "ChampLong" : "ChampShort") + '"}', alert.freq_once_per_bar_close)
    strategy.cancel(pendDir == 1 ? "ChampLong" : "ChampShort")
    pendDir := 0
    pendLvl := na

// ---------- PASANG ORDER LIMIT RETEST + EVENT JSON ----------
if longSig and flat
    // kalau ada pending arah lawan -> event CANCEL OPPOSITE_SIGNAL dulu
    if pendDir != 0 and pendDir != 1
        alert('{"event":"CANCEL_PENDING","strategy":"' + strategyName + '","symbol":"' + symbolName + '","timeframe":"' + tfName + '","candleTime":' + str.tostring(time) + ',"reason":"OPPOSITE_SIGNAL","side":"SELL","orderRef":"' + strategyName + ':ChampShort"}', alert.freq_once_per_bar_close)
    replacing = pendDir == 1
    sideStr = "BUY"
    idStr = strategyName + ":" + str.tostring(time) + ":" + sideStr
    orderRef = strategyName + ":ChampLong"
    entryPrice = f_round2(lvlRetest)
    slPrice = f_round2(lvlRetest - slUsd)
    tpPrice = f_round2(lvlRetest + tpUsd)
    alert('{"event":"' + (replacing ? "REPLACE_LIMIT" : "PLACE_LIMIT") + '","strategy":"' + strategyName + '","symbol":"' + symbolName + '","timeframe":"' + tfName + '","candleTime":' + str.tostring(time) + ',"id":"' + idStr + '","orderRef":"' + orderRef + '","side":"' + sideStr + '","orderType":"LIMIT","entry":' + str.tostring(entryPrice) + ',"sl":' + str.tostring(slPrice) + ',"tp":' + str.tostring(tpPrice) + ',"qtyOz":' + str.tostring(qtyOz) + ',"lot":' + str.tostring(math.round(qtyOz / 100.0 * 100) / 100.0) + ',"maxBarsToFill":' + str.tostring(retestBars) + ',"meta":{"adx":' + f_numOrNull(adxV) + ',"diPlus":' + f_numOrNull(diPlusV) + ',"diMinus":' + f_numOrNull(diMinusV) + ',"bodyPct":' + f_numOrNull(bodyPct) + ',"lastFractalHigh":' + f_numOrNull(lastPH) + ',"lastFractalLow":' + f_numOrNull(lastPL) + ',"retestMode":"' + retestMode + '"}}', alert.freq_once_per_bar_close)
    // quirks broker PineTS: re-call entry id sama saat pending membuat order
    // hilang -> cancel dulu lalu entry baru (TradingView: tidak perlu)
    strategy.cancel("ChampShort")
    if replacing
        strategy.cancel("ChampLong")
    strategy.entry("ChampLong", strategy.long, qty=qtyOz, limit=lvlRetest, comment="BUY retest")
    strategy.exit("ExitLong", from_entry="ChampLong", stop=lvlRetest - slUsd, limit=lvlRetest + tpUsd)
    pendDir := 1
    pendBar := bar_index
    pendLvl := lvlRetest

if shortSig and flat
    if pendDir != 0 and pendDir != -1
        alert('{"event":"CANCEL_PENDING","strategy":"' + strategyName + '","symbol":"' + symbolName + '","timeframe":"' + tfName + '","candleTime":' + str.tostring(time) + ',"reason":"OPPOSITE_SIGNAL","side":"BUY","orderRef":"' + strategyName + ':ChampLong"}', alert.freq_once_per_bar_close)
    replacingS = pendDir == -1
    sideStrS = "SELL"
    idStrS = strategyName + ":" + str.tostring(time) + ":" + sideStrS
    orderRefS = strategyName + ":ChampShort"
    entryPriceS = f_round2(lvlRetest)
    slPriceS = f_round2(lvlRetest + slUsd)
    tpPriceS = f_round2(lvlRetest - tpUsd)
    alert('{"event":"' + (replacingS ? "REPLACE_LIMIT" : "PLACE_LIMIT") + '","strategy":"' + strategyName + '","symbol":"' + symbolName + '","timeframe":"' + tfName + '","candleTime":' + str.tostring(time) + ',"id":"' + idStrS + '","orderRef":"' + orderRefS + '","side":"' + sideStrS + '","orderType":"LIMIT","entry":' + str.tostring(entryPriceS) + ',"sl":' + str.tostring(slPriceS) + ',"tp":' + str.tostring(tpPriceS) + ',"qtyOz":' + str.tostring(qtyOz) + ',"lot":' + str.tostring(math.round(qtyOz / 100.0 * 100) / 100.0) + ',"maxBarsToFill":' + str.tostring(retestBars) + ',"meta":{"adx":' + f_numOrNull(adxV) + ',"diPlus":' + f_numOrNull(diPlusV) + ',"diMinus":' + f_numOrNull(diMinusV) + ',"bodyPct":' + f_numOrNull(bodyPct) + ',"lastFractalHigh":' + f_numOrNull(lastPH) + ',"lastFractalLow":' + f_numOrNull(lastPL) + ',"retestMode":"' + retestMode + '"}}', alert.freq_once_per_bar_close)
    strategy.cancel("ChampLong")
    if replacingS
        strategy.cancel("ChampShort")
    strategy.entry("ChampShort", strategy.short, qty=qtyOz, limit=lvlRetest, comment="SELL retest")
    strategy.exit("ExitShort", from_entry="ChampShort", stop=lvlRetest + slUsd, limit=lvlRetest - tpUsd)
    pendDir := -1
    pendBar := bar_index
    pendLvl := lvlRetest

// tutup paksa di akhir sesi (opsional) + event
if endSess and (not inSess) and strategy.position_size != 0
    alert('{"event":"CLOSE_POSITION","strategy":"' + strategyName + '","symbol":"' + symbolName + '","timeframe":"' + tfName + '","candleTime":' + str.tostring(time) + ',"reason":"END_OF_SESSION"}', alert.freq_once_per_bar_close)
    strategy.close_all(comment="Akhir sesi")

// ---------- PLOT UNTUK PANE CHART WEBSITE ----------
plot(adxV, "ADX", color=color.orange)
plot(diPlusV, "DI+", color=color.teal)
plot(diMinusV, "DI-", color=color.maroon)
