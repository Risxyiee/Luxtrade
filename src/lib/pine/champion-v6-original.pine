//@version=5
// ============================================================
//  CHAMPION XAUUSD H1 - v6 FINAL (semua bisa diatur di Inputs)
//  Resep teruji 3 tahun data Dukascopy:
//    body 83% | fractal 3 | pending hangus 9 bar | retest Close
//    BUY saja | SL 20 / TP 40 (RR 1:2) | qty 7 oz = lot 0.07
//  Pemakaian:
//    - Challenge (biar cepat) : qty 7  (default)
//    - Sudah funded (biar aman): qty 5  -> ubah "Qty posisi" jadi 5
//    - Mau nambah SELL         : centang "Aktifkan SELL"
//    - Semua angka lain (body, ADX, fractal, SL, TP, sesi)
//      bisa diganti di menu Inputs TANPA edit kode.
//  Catatan lot: qty 7 oz = lot 0.07 | qty 5 oz = lot 0.05
// ============================================================

strategy("Champion XAUUSD H1 - Final v6", shorttitle="Champion v6", overlay=true, initial_capital=10000, currency=currency.USD, default_qty_type=strategy.fixed, default_qty_value=7, commission_type=strategy.commission.cash_per_order, commission_value=0.035, slippage=3, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=false)

// ---------- INPUT (semua bisa diatur sendiri) ----------
grpS = "Sinyal"
bodyMin    = input.float(83.0, "Body minimal (% dari range)", minval=0.0, maxval=100.0, step=1.0, group=grpS, tooltip="Candle sinyal harus punya body sebesar ini. 83 = hasil backtest terbaik. Makin tinggi = sinyal makin jarang.")
adxLen     = input.int(10, "ADX DI Length", minval=1, group=grpS, tooltip="Panjang DMI untuk DI+ / DI-.")
adxSmooth  = input.int(14, "ADX Smoothing (Wilder)", minval=1, group=grpS, tooltip="Penghalus ADX (Wilder).")
adxMin     = input.float(17.0, "ADX minimal", minval=1.0, step=0.5, group=grpS, tooltip="Sinyal hanya valid kalau ADX >= angka ini (trend kuat).")
allowLong  = input.bool(true, "Aktifkan BUY", group=grpS)
allowShort = input.bool(false, "Aktifkan SELL", group=grpS, tooltip="Default MATI (resep final BUY saja). Backtest SELL: profit tapi lebih lemah dari BUY.")

grpF = "Fractal"
useFractal = input.bool(true, "Breakout harus tembus fractal", group=grpF, tooltip="Close harus lewat fractal high/low terakhir.")
frLen      = input.int(3, "Panjang fractal (bar kiri = kanan)", minval=1, group=grpF, tooltip="3 = hasil backtest terbaik.")

grpR = "Entry Retest"
retestMode = input.string("Close sinyal", "Level retest", options=["Open sinyal", "50% sinyal", "Close sinyal"], group=grpR, tooltip="Close sinyal = hasil backtest terbaik. Open sinyal = terburuk (rugi di 3 tahun).")
retestBars = input.int(9, "Maks bar nunggu retest", minval=1, maxval=50, group=grpR, tooltip="Kalau harga gak balik ke level dalam 9 bar, order hangus.")

grpT = "Trading"
slUsd    = input.float(20.0, "Stop Loss (USD)", minval=0.1, step=0.5, group=grpT, tooltip="Jarak SL dari harga entry, dalam dolar emas. 20 = paling aman buat akun instant (butuh 6 loss beruntun buat gugur). 30 = lebih cepat tapi 4 loss beruntun bisa gugur.")
tpUsd    = input.float(40.0, "Take Profit (USD)", minval=0.1, step=0.5, group=grpT, tooltip="Jarak TP dari harga entry. 40 = RR 1:2 pasangan SL 20, RR 1:1.3 pasangan SL 30.")
qtyOz    = input.float(7.0, "Qty posisi (7 oz = lot 0.07)", minval=0.01, step=0.01, group=grpT, tooltip="7 oz = lot 0.07 (challenge, cepat). 5 oz = lot 0.05 (funded, aman).")
sessStr  = input.session("0730-2200", "Sesi trading (WIB)", group=grpT)
endSess  = input.bool(false, "Tutup paksa posisi di akhir sesi", group=grpT)
showInfo = input.bool(true, "Tampilkan panel info", group=grpT)

// ---------- SESI (WIB) ----------
inSess = not na(time(timeframe.period, sessStr, "Asia/Jakarta"))

// ---------- INDIKATOR ----------
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxSmooth)

// fractal high/low: konfirmasi frLen bar kiri & kanan, gak repaint
ph = ta.pivothigh(high, frLen, frLen)
pl = ta.pivotlow(low, frLen, frLen)
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

rng     = high - low
bodyAbs = math.abs(close - open)
bodyPct = rng > 0 ? (bodyAbs / rng) * 100.0 : 0.0

bodyOk = bodyPct >= bodyMin
adxOk  = adxVal >= adxMin
brkUp  = close > math.max(high[1], high[2])
brkDn  = close < math.min(low[1], low[2])
fracUp = (not useFractal) or na(lastPH) or (close > lastPH)
fracDn = (not useFractal) or na(lastPL) or (close < lastPL)
diUp   = diPlus > diMinus
diDn   = diMinus > diPlus

longSig  = allowLong and (close > open) and brkUp and bodyOk and adxOk and diUp and fracUp and inSess
shortSig = allowShort and (close < open) and brkDn and bodyOk and adxOk and diDn and fracDn and inSess

// level retest dari candle sinyal
lvlRetest = retestMode == "Open sinyal" ? open : retestMode == "50% sinyal" ? (open + close) / 2 : close

// ---------- STATE ORDER PENDING ----------
flat = strategy.position_size == 0
var int   pendDir = 0
var int   pendBar = 0
var float pendLvl = na

// bersihkan status kalau posisi udah kebuka
if strategy.position_size != 0
    pendDir := 0

// kedaluwarsa: pending gak keisi dalam retestBars bar -> batalin
if pendDir != 0 and (bar_index - pendBar) >= retestBars
    strategy.cancel(pendDir == 1 ? "ChampLong" : "ChampShort")
    pendDir := 0
    pendLvl := na

// keluar sesi -> pending dibatalin (posisi tetap dipegang kecuali endSess aktif)
if (not inSess) and pendDir != 0
    strategy.cancel(pendDir == 1 ? "ChampLong" : "ChampShort")
    pendDir := 0
    pendLvl := na

// ---------- PASANG ORDER LIMIT RETEST ----------
if longSig and flat
    strategy.cancel("ChampShort")
    strategy.entry("ChampLong", strategy.long, qty=qtyOz, limit=lvlRetest, comment="BUY retest")
    strategy.exit("ExitLong", from_entry="ChampLong", stop=lvlRetest - slUsd, limit=lvlRetest + tpUsd)
    pendDir := 1
    pendBar := bar_index
    pendLvl := lvlRetest

if shortSig and flat
    strategy.cancel("ChampLong")
    strategy.entry("ChampShort", strategy.short, qty=qtyOz, limit=lvlRetest, comment="SELL retest")
    strategy.exit("ExitShort", from_entry="ChampShort", stop=lvlRetest + slUsd, limit=lvlRetest - tpUsd)
    pendDir := -1
    pendBar := bar_index
    pendLvl := lvlRetest

// tutup paksa di akhir sesi (opsional)
if endSess and (not inSess) and strategy.position_size != 0
    strategy.close_all(comment="Akhir sesi")

// ---------- VISUAL ----------
plotshape(longSig, title="Sinyal BUY", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.small)
plotshape(shortSig, title="Sinyal SELL", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)
plot(pendDir == 1 ? pendLvl : na, title="Level retest BUY", style=plot.style_linebr, color=color.new(color.lime, 20), linewidth=1)
plot(pendDir == -1 ? pendLvl : na, title="Level retest SELL", style=plot.style_linebr, color=color.new(color.red, 20), linewidth=1)
plot(useFractal ? lastPH : na, title="Fractal high", style=plot.style_stepline, color=color.new(color.aqua, 50), linewidth=1)
plot(useFractal ? lastPL : na, title="Fractal low", style=plot.style_stepline, color=color.new(color.orange, 60), linewidth=1)
plot(strategy.position_size != 0 ? strategy.position_avg_price : na, title="Harga entry", style=plot.style_linebr, color=color.new(color.gray, 30), linewidth=1)
bgcolor(not inSess ? color.new(color.gray, 92) : na, title="Di luar sesi")

// alert untuk strategy: pakai alert(), bukan alertcondition (gak jalan di strategy)
// cara pakai: bikin alert -> kondisi "Any alert() function call"
if longSig
    alert("Champion XAUUSD H1: sinyal BUY, order limit retest terpasang @ " + str.tostring(lvlRetest, "#.##"), alert.freq_once_per_bar_close)
if shortSig
    alert("Champion XAUUSD H1: sinyal SELL, order limit retest terpasang @ " + str.tostring(lvlRetest, "#.##"), alert.freq_once_per_bar_close)

// ---------- PANEL INFO ----------
posTxt = strategy.position_size > 0 ? "LONG" : (strategy.position_size < 0 ? "SHORT" : (pendDir != 0 ? "NUNGGU" : "IDLE"))
var table infoT = table.new(position.top_right, 2, 6, border_width=1, frame_width=1, frame_color=color.gray)
// panel di-update tiap bar close (isconfirmed) -> tanpa warning calc_on_every_tick
if showInfo and barstate.isconfirmed
    table.cell(infoT, 0, 0, "ADX", text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(infoT, 1, 0, str.tostring(adxVal, "#.##"), text_color=adxOk ? color.lime : color.orange, bgcolor=color.new(color.black, 15))
    table.cell(infoT, 0, 1, "Body %", text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(infoT, 1, 1, str.tostring(bodyPct, "#.#"), text_color=bodyOk ? color.lime : color.orange, bgcolor=color.new(color.black, 15))
    table.cell(infoT, 0, 2, "DI+ / DI-", text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(infoT, 1, 2, str.tostring(diPlus, "#.##") + " / " + str.tostring(diMinus, "#.##"), text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(infoT, 0, 3, "Fractal PH/PL", text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(infoT, 1, 3, str.tostring(lastPH, "#.##") + " / " + str.tostring(lastPL, "#.##"), text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(infoT, 0, 4, "SL / TP (RR)", text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(infoT, 1, 4, str.tostring(slUsd, "#.#") + " / " + str.tostring(tpUsd, "#.#") + " (1:" + str.tostring(tpUsd / slUsd, "#.##") + ")", text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(infoT, 0, 5, "Posisi", text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(infoT, 1, 5, posTxt, text_color=strategy.position_size > 0 ? color.lime : (strategy.position_size < 0 ? color.red : (pendDir != 0 ? color.yellow : color.white)), bgcolor=color.new(color.black, 15))
