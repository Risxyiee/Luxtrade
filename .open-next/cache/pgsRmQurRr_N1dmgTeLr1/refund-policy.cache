/_next/static/chunks/18f38dbeee9f54d3.js\" async=\"\"></script><script src=\"/_next/static/chunks/a5efe8df4619f388.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>LuxTrade - AI Trading Journal Indonesia | Catat Trade, Deteksi Kesalahan, Naikkan Win Rate</title><meta name=\"description\" content=\"Trading journal dengan AI untuk trader Indonesia. Screenshot trade dari MT4/MT5, AI auto-extract data &amp; deteksi pola kesalahan berulang. Equity curve, analisis psikologi trading, risk calculator. Gratis 10 trade/bulan.\"/><meta name=\"author\" content=\"LuxTrade\"/><meta name=\"keywords\" content=\"trading journal,jurnal trading,trading journal Indonesia,AI trading journal,jurnal trading AI,catat trade,analisis trading,forex journal,jurnal forex,equity curve,deteksi kesalahan trading,trading psikologi,risk calculator forex,MT4 journal,MT5 journal,luxtrade\"/><meta property=\"og:title\" content=\"LuxTrade - AI Trading Journal Indonesia | Catat Trade, Deteksi Kesalahan, Naikkan Win Rate\"/><meta property=\"og:description\" content=\"Trading journal dengan AI untuk trader Indonesia. Screenshot trade dari MT4/MT5, AI auto-extract data &amp; deteksi pola kesalahan berulang. Gratis 10 trade/bulan.\"/><meta property=\"og:site_name\" content=\"LuxTrade\"/><meta property=\"og:locale\" content=\"id_ID\"/><meta property=\"og:image\" content=\"http://localhost:3000/logo.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"LuxTrade - AI Trading Journal Indonesia\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"LuxTrade - AI Trading Journal Indonesia\"/><meta name=\"twitter:description\" content=\"Trading journal dengan AI untuk trader Indonesia. Catat trade, deteksi kesalahan, naikkan win rate.\"/><meta name=\"twitter:image\" content=\"http://localhost:3000/logo.png\"/><link rel=\"icon\" href=\"/logo.png\"/><script>\n              (function() {\n                try {\n                  var theme = localStorage.getItem('luxtrade-theme');\n                  if (theme === 'light') {\n                    document.documentElement.classList.add('light');\n                  } else {\n                    document.documentElement.classList.add('dark');\n                  }\n                } catch(e) {\n                  document.documentElement.classList.add('dark');\n                }\n              })();\n            </script><script src=\"/_next/static/chunks/a6dad97d9634a72d.js\" noModule=\"\"></script></head><body class=\"inter_7b064e0d-module__MOT0tq__variable lexend_99ca8c04-module__K1QbjW__variable antialiased font-sans\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:bg-blue-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-md\">Skip to main content</a><!--$--><div class=\"min-h-screen bg-[#0a0612] text-white\"><div class=\"fixed inset-0 -z-10\"><div class=\"absolute inset-0 bg-gradient-to-b from-[#0a0612] via-[#110a1f] to-[#0a0612]\"></div><div class=\"absolute top-0 left-1/4 w-[600px] h-[600px] bg-blue-500/5 rounded-full blur-[150px]\"></div></div><header class=\"border-b border-white/5 bg-[#0a0612]/80 backdrop-blur-xl sticky top-0 z-50\"><div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center justify-between\"><a class=\"inline-flex items-center gap-3\" href=\"/\"><img alt=\"LuxTrade Logo\" loading=\"lazy\" width=\"36\" height=\"36\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Flogo-premium.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2Flogo-premium.png&amp;w=96&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo-premium.png&amp;w=96&amp;q=75\"/><span class=\"text-lg font-bold bg-gradient-to-r from-cyan-200 to-cyan-400 bg-clip-text text-transparent\">LuxTrade</span></a><a href=\"/\"><button data-slot=\"button\" class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive hover:bg-accent dark:hover:bg-accent/50 h-9 px-4 py-2 has-[&gt;svg]:px-3 text-white/60 hover:text-white\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-left w-4 h-4 mr-2\" aria-hidden=\"true\"><path d=\"m12 19-7-7 7-7\"></path><path d=\"M19 12H5\"></path></svg>Kembali</button></a></div></header><main class=\"max-w-4xl mx-auto px-4 py-12\"><div style=\"opacity:0;transform:translateY(20px)\"><h1 class=\"text-4xl font-bold mb-2\">Kebijakan Pengembalian Dana (Refund Policy)</h1><p class=\"text-white/40 mb-8\">Terakhir diperbarui: <!-- -->30 Agustus 2026</p><div class=\"bg-gradient-to-r from-red-500/10 via-blue-500/10 to-red-500/10 border border-red-500/25 rounded-2xl p-5 mb-8\"><p class=\"text-white/80 leading-relaxed text-sm\"><strong class=\"text-red-300\">⚠️ Penting:</strong> LuxTrade adalah produk digital berupa langganan SaaS (Software-as-a-Service). Ini <strong class=\"text-red-300\">BUKAN barang fisik</strong> yang dapat dikembalikan. Seluruh pembelian langganan bersifat <strong class=\"text-red-300\">FINAL dan TIDAK DAPAT dikembalikan (non-refundable)</strong> secara default, sesuai dengan sifat produk digital yang diakses secara instan setelah pembayaran berhasil.</p></div><div class=\"prose prose-invert max-w-none space-y-8\"><section><h2 class=\"text-2xl font-semibold text-white mb-4\">1. Sifat Produk Digital</h2><p class=\"text-white/70 leading-relaxed\">LuxTrade adalah produk digital berupa layanan SaaS (Software-as-a-Service) yang memberikan akses perangkat lunak berbasis web untuk pencatatan dan analisis data trading. Layanan ini bukan merupakan barang fisik yang dapat dikirim, disimpan, atau dikembalikan secara fisik.</p><ul class=\"list-disc list-inside space-y-2 text-white/70 mt-4\"><li>Setelah akses premium diaktifkan, produk tersebut tidak dapat &quot;dikembalikan&quot; karena sifatnya adalah hak akses digital</li><li>Pengguna langsung mendapatkan manfaat dari fitur premium sejak saat aktivasi</li><li>Ketentuan ini sejalan dengan <strong class=\"text-cyan-400\">UU No. 11 Tahun 2008 Pasal 4 Ayat 3</strong> tentang Informasi dan Transaksi Elektronik (ITE), yang memberikan pengecualian atas hak pengembalian untuk konten digital yang telah diakses</li></ul></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">2. Ketentuan Non-Refundable</h2><div class=\"space-y-4\"><div class=\"bg-red-500/10 border border-red-500/20 rounded-xl p-5\"><p class=\"text-white/70 leading-relaxed\"><strong class=\"text-red-300\">Semua pembelian langganan bersifat FINAL dan TIDAK DAPAT dikembalikan.</strong></p></div><ul class=\"list-disc list-inside space-y-2 text-white/70\"><li>Seluruh pembelian paket langganan — termasuk <strong>Elite Pro 1 Bulan</strong>, <strong>Elite Pro 6 Bulan</strong>, dan <strong>Lifetime</strong> — bersifat final dan non-refundable</li><li>Setelah akun pengguna berhasil di-upgrade ke status <strong class=\"text-cyan-400\">Pro</strong>, tidak ada pengembalian dana yang dapat diproses</li><li>Kami menyediakan <strong>free trial (uji coba gratis) selama 7 hari</strong> agar pengguna dapat mengevaluasi seluruh fitur premium sebelum memutuskan untuk berlangganan</li><li>Pengguna disarankan untuk memanfaatkan masa trial secara penuh sebelum melakukan pembelian</li></ul></div></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">3. Pengecualian Refund</h2><p class=\"text-white/70 leading-relaxed mb-4\">Pengembalian dana <strong class=\"text-cyan-400\">hanya</strong> dapat diproses dalam kondisi berikut:</p><div class=\"space-y-4\"><div class=\"bg-white/[0.02] border border-white/5 rounded-xl p-5\"><h3 class=\"text-lg font-medium text-cyan-400 mb-2\">Pembayaran Ganda (Double Charge)</h3><p class=\"text-white/70\">Jika Anda terkena potongan dua kali untuk transaksi yang sama, kami akan mengembalikan dana secara <strong>penuh (full refund)</strong> untuk salah satu transaksi.</p></div><div class=\"bg-white/[0.02] border border-white/5 rounded-xl p-5\"><h3 class=\"text-lg font-medium text-cyan-400 mb-2\">Kesalahan Teknis dari Sistem Pembayaran</h3><p class=\"text-white/70\">Jika terjadi kesalahan teknis dari pihak payment gateway yang menyebabkan transaksi bermasalah, kami akan mengembalikan dana secara <strong>penuh (full refund)</strong>.</p></div><div class=\"bg-white/[0.02] border border-white/5 rounded-xl p-5\"><h3 class=\"text-lg font-medium text-cyan-400 mb-2\">Akses Tidak Aktif Setelah Pembayaran Dikonfirmasi</h3><p class=\"text-white/70\">Jika pembayaran Anda telah berhasil dan terkonfirmasi, namun akses premium tidak kunjung aktif, kami akan melakukan <strong>pengembalian dana penuh (full refund)</strong> atau <strong>reaktivasi manual</strong> akun Anda.</p></div><div class=\"bg-red-500/10 border border-red-500/20 rounded-xl p-5\"><p class=\"text-white/70 leading-relaxed\"><strong class=\"text-red-300\">Batas waktu pengajuan:</strong> Permintaan refund atas pengecualian di atas harus diajukan dalam waktu <strong>maksimal 7 hari</strong> sejak insiden terjadi, melalui Discord <strong class=\"text-cyan-400\">LuxTrade Server</strong> atau email <strong class=\"text-cyan-400\">luxtradee@gmail.com</strong>.</p></div></div></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">4. Proses Pengajuan Refund</h2><div class=\"space-y-4\"><div class=\"bg-white/[0.02] border border-white/5 rounded-xl p-5\"><h3 class=\"text-lg font-medium text-cyan-400 mb-2\">Langkah Pengajuan</h3><ul class=\"list-disc list-inside space-y-2 text-white/70\"><li>Hubungi kami melalui <strong class=\"text-cyan-400\">Discord (LuxTrade Server)</strong> atau email <strong class=\"text-cyan-400\">luxtradee@gmail.com</strong></li><li>Sertakan bukti pendukung (screenshot pembayaran ganda, bukti transfer, dll.)</li><li>Sertakan informasi akun: email terdaftar dan tanggal transaksi</li></ul></div><div class=\"bg-white/[0.02] border border-white/5 rounded-xl p-5\"><h3 class=\"text-lg font-medium text-cyan-400 mb-2\">Waktu Proses</h3><p class=\"text-white/70\">Pengembalian dana akan diproses dalam waktu <strong>maksimal 7 hari kerja</strong> sejak pengajuan diterima dan diverifikasi.</p></div><div class=\"bg-white/[0.02] border border-white/5 rounded-xl p-5\"><h3 class=\"text-lg font-medium text-cyan-400 mb-2\">Metode Pengembalian</h3><p class=\"text-white/70\">Refund akan dikirimkan ke <strong>metode pembayaran asli</strong> yang digunakan saat transaksi (sumber dana yang sama).</p></div></div></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">5. Free Trial</h2><div class=\"space-y-4\"><div class=\"bg-white/[0.02] border border-white/5 rounded-xl p-5\"><h3 class=\"text-lg font-medium text-cyan-400 mb-2\">Uji Coba Gratis 7 Hari</h3><ul class=\"list-disc list-inside space-y-2 text-white/70\"><li>Free trial selama <strong>7 hari</strong> tersedia untuk semua pengguna baru LuxTrade</li><li>Pengguna disarankan untuk memanfaatkan masa trial secara penuh guna mengevaluasi fitur premium sebelum melakukan pembelian</li><li>Trial akan aktif setelah pengguna melakukan <strong>verifikasi email</strong></li><li>Free trial bersifat <strong>sekali pakai</strong> — tidak tersedia bagi pengguna yang sebelumnya sudah pernah memiliki status Pro</li></ul></div></div></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">6. Hubungi Kami</h2><p class=\"text-white/70 leading-relaxed mb-4\">Jika Anda memiliki pertanyaan mengenai Kebijakan Pengembalian Dana ini, silakan hubungi kami:</p><div class=\"bg-white/[0.02] border border-white/5 rounded-xl p-5 space-y-3\"><p class=\"text-white/70\"><strong class=\"text-cyan-400\">Nama Usaha:</strong> LuxTrade</p><p class=\"text-white/70\"><strong class=\"text-cyan-400\">Email:</strong> luxtradee@gmail.com</p><p class=\"text-white/70\"><strong class=\"text-cyan-400\">Telepon:</strong> +62 857-1205-4394</p><p class=\"text-white/70\"><strong class=\"text-cyan-400\">Alamat Usaha:</strong> Jakarta, Indonesia</p><p class=\"text-white/70\"><strong class=\"text-cyan-400\">Website:</strong> luxtradee.web.id</p></div></section></div></div></main><footer class=\"border-t border-white/5 py-8 mt-12\"><div class=\"max-w-4xl mx-auto px-4 text-center text-white/40 text-sm\"><p>© <!-- -->2026<!-- --> LuxTrade. All rights reserved.</p><div class=\"flex justify-center flex-wrap gap-6 mt-4\"><a class=\"hover:text-white transition-colors\" href=\"/disclaimer\">Disclaimer</a><a class=\"hover:text-white transition-colors\" href=\"/privacy\">Privacy Policy</a><a class=\"hover:text-white transition-colors\" href=\"/terms\">Terms of Service</a><a class=\"hover:text-white transition-colors\" href=\"/refund-policy\">Refund Policy</a><a class=\"hover:text-white transition-colors\" href=\"/faq\">FAQ</a><a class=\"hover:text-white transition-colors\" href=\"/kontak\">Kontak</a></div></div></footer></div><!--$--><!--/$--><!--/$--><section aria-label=\"Notifications alt+T\" tabindex=\"-1\" aria-live=\"polite\" aria-relevant=\"additions text\" aria-atomic=\"false\"></section><script src=\"/_next/static/chunks/66a8c16702b8a250.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[60255,[\\\"/_next/static/chunks/13622ac9f698f252.js\\\",\\\