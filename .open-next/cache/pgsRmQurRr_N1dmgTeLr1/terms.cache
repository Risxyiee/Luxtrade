\" async=\"\"></script><script src=\"/_next/static/chunks/94f6befb6ec2b92f.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>LuxTrade - AI Trading Journal Indonesia | Catat Trade, Deteksi Kesalahan, Naikkan Win Rate</title><meta name=\"description\" content=\"Trading journal dengan AI untuk trader Indonesia. Screenshot trade dari MT4/MT5, AI auto-extract data &amp; deteksi pola kesalahan berulang. Equity curve, analisis psikologi trading, risk calculator. Gratis 10 trade/bulan.\"/><meta name=\"author\" content=\"LuxTrade\"/><meta name=\"keywords\" content=\"trading journal,jurnal trading,trading journal Indonesia,AI trading journal,jurnal trading AI,catat trade,analisis trading,forex journal,jurnal forex,equity curve,deteksi kesalahan trading,trading psikologi,risk calculator forex,MT4 journal,MT5 journal,luxtrade\"/><meta property=\"og:title\" content=\"LuxTrade - AI Trading Journal Indonesia | Catat Trade, Deteksi Kesalahan, Naikkan Win Rate\"/><meta property=\"og:description\" content=\"Trading journal dengan AI untuk trader Indonesia. Screenshot trade dari MT4/MT5, AI auto-extract data &amp; deteksi pola kesalahan berulang. Gratis 10 trade/bulan.\"/><meta property=\"og:site_name\" content=\"LuxTrade\"/><meta property=\"og:locale\" content=\"id_ID\"/><meta property=\"og:image\" content=\"http://localhost:3000/logo.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"LuxTrade - AI Trading Journal Indonesia\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"LuxTrade - AI Trading Journal Indonesia\"/><meta name=\"twitter:description\" content=\"Trading journal dengan AI untuk trader Indonesia. Catat trade, deteksi kesalahan, naikkan win rate.\"/><meta name=\"twitter:image\" content=\"http://localhost:3000/logo.png\"/><link rel=\"icon\" href=\"/logo.png\"/><script>\n              (function() {\n                try {\n                  var theme = localStorage.getItem('luxtrade-theme');\n                  if (theme === 'light') {\n                    document.documentElement.classList.add('light');\n                  } else {\n                    document.documentElement.classList.add('dark');\n                  }\n                } catch(e) {\n                  document.documentElement.classList.add('dark');\n                }\n              })();\n            </script><script src=\"/_next/static/chunks/a6dad97d9634a72d.js\" noModule=\"\"></script></head><body class=\"inter_7b064e0d-module__MOT0tq__variable lexend_99ca8c04-module__K1QbjW__variable antialiased font-sans\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:bg-blue-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-md\">Skip to main content</a><!--$--><div class=\"min-h-screen bg-[#0a0612] text-white\"><div class=\"fixed inset-0 -z-10\"><div class=\"absolute inset-0 bg-gradient-to-b from-[#0a0612] via-[#110a1f] to-[#0a0612]\"></div><div class=\"absolute top-0 left-1/4 w-[600px] h-[600px] bg-blue-500/5 rounded-full blur-[150px]\"></div></div><header class=\"border-b border-white/5 bg-[#0a0612]/80 backdrop-blur-xl sticky top-0 z-50\"><div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center justify-between\"><a class=\"inline-flex items-center gap-3\" href=\"/\"><img alt=\"LuxTrade Logo\" loading=\"lazy\" width=\"36\" height=\"36\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Flogo-premium.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2Flogo-premium.png&amp;w=96&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo-premium.png&amp;w=96&amp;q=75\"/><span class=\"text-lg font-bold bg-gradient-to-r from-cyan-200 to-cyan-400 bg-clip-text text-transparent\">LuxTrade</span></a><a href=\"/\"><button data-slot=\"button\" class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive hover:bg-accent dark:hover:bg-accent/50 h-9 px-4 py-2 has-[&gt;svg]:px-3 text-white/60 hover:text-white\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-left w-4 h-4 mr-2\" aria-hidden=\"true\"><path d=\"m12 19-7-7 7-7\"></path><path d=\"M19 12H5\"></path></svg>Kembali</button></a></div></header><main class=\"max-w-4xl mx-auto px-4 py-12\"><div style=\"opacity:0;transform:translateY(20px)\"><h1 class=\"text-4xl font-bold mb-2\">Terms of Service</h1><p class=\"text-white/40 mb-8\">Terakhir diperbarui: <!-- -->30 Agustus 2026</p><div class=\"bg-gradient-to-r from-red-500/10 via-blue-500/10 to-red-500/10 border border-red-500/25 rounded-2xl p-5 mb-8\"><p class=\"text-white/80 leading-relaxed text-sm\"><strong class=\"text-red-300\">Penting:</strong> LuxTrade adalah platform perangkat lunak (SaaS) untuk analisis data trading. Kami <strong>BUKAN broker, BUKAN pialang berjangka, dan BUKAN pengelola dana</strong>. Selengkapnya baca halaman <a class=\"text-cyan-400 underline hover:text-cyan-300\" href=\"/disclaimer\">Disclaimer</a>.</p></div><div class=\"prose prose-invert max-w-none space-y-8\"><section><h2 class=\"text-2xl font-semibold text-white mb-4\">1. Penerimaan Ketentuan</h2><p class=\"text-white/70 leading-relaxed\">Dengan mengakses atau menggunakan LuxTrade, Anda menyetujui untuk terikat dengan Ketentuan Layanan ini. Jika Anda tidak menyetujui ketentuan ini, mohon untuk tidak menggunakan layanan kami.</p></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">2. Deskripsi Layanan</h2><p class=\"text-white/70 leading-relaxed\">LuxTrade adalah platform Software-as-a-Service (SaaS) berupa dashboard analisis data untuk membantu trader ritel mencatat, memantau, dan mengevaluasi performa trading mereka. Layanan ini BUKAN merupakan platform trading, broker, pialang, atau pengelola investasi. Layanan mencakup:</p><ul class=\"list-disc list-inside space-y-2 text-white/70 mt-4\"><li>Pencatatan dan manajemen data trading</li><li>Analitik dan statistik performa</li><li>Insight AI untuk pembelajaran</li><li>Tools kalkulator risiko</li><li>Fitur berbagi hasil trading</li></ul></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">3. Akun Pengguna</h2><div class=\"space-y-4\"><div class=\"bg-white/[0.02] border border-white/5 rounded-xl p-5\"><h3 class=\"text-lg font-medium text-cyan-400 mb-2\">Registrasi</h3><p class=\"text-white/70\">Anda harus memberikan informasi yang akurat dan lengkap saat mendaftar. Anda bertanggung jawab menjaga kerahasiaan password akun Anda.</p></div><div class=\"bg-white/[0.02] border border-white/5 rounded-xl p-5\"><h3 class=\"text-lg font-medium text-cyan-400 mb-2\">Keamanan Akun</h3><p class=\"text-white/70\">Anda bertanggung jawab atas semua aktivitas yang terjadi di akun Anda. Segera laporkan jika mencurigai penggunaan tidak sah.</p></div><div class=\"bg-white/[0.02] border border-white/5 rounded-xl p-5\"><h3 class=\"text-lg font-medium text-cyan-400 mb-2\">Penghapusan Akun</h3><p class=\"text-white/70\">Anda dapat menghapus akun kapan saja. Penghapusan akun akan menghasilkan penghapusan semua data Anda.</p></div></div></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">4. Penggunaan yang Dilarang</h2><p class=\"text-white/70 leading-relaxed mb-4\">Anda dilarang untuk:</p><ul class=\"list-disc list-inside space-y-2 text-white/70\"><li>Menggunakan layanan untuk tujuan ilegal</li><li>Mencoba mengakses sistem atau data pengguna lain tanpa izin</li><li>Mengganggu atau merusak operasi layanan</li><li>Menggunakan bot atau sistem otomatis tanpa izin</li><li>Menyebarkan malware atau kode berbahaya</li><li>Menjual atau mentransfer akun Anda</li></ul></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">5. Langganan dan Pembayaran</h2><div class=\"space-y-4\"><div class=\"bg-white/[0.02] border border-white/5 rounded-xl p-5\"><h3 class=\"text-lg font-medium text-cyan-400 mb-2\">Paket Gratis</h3><p class=\"text-white/70\">Fitur dasar tersedia gratis dengan batasan jumlah trades per bulan.</p></div><div class=\"bg-white/[0.02] border border-white/5 rounded-xl p-5\"><h3 class=\"text-lg font-medium text-cyan-400 mb-2\">Paket Pro &amp; Lifetime</h3><p class=\"text-white/70\">Akses penuh ke semua fitur premium tanpa batasan. Pembayaran dilakukan melalui QRIS (Quick Response Code Indonesian Standard) yang dapat diakses melalui e-wallet atau mobile banking manapun.</p></div><div class=\"bg-red-500/10 border border-red-500/20 rounded-xl p-5\"><h3 class=\"text-lg font-medium text-red-400 mb-2\">Produk Digital — Non-Refundable</h3><p class=\"text-white/70 leading-relaxed\"><strong class=\"text-red-300\">Pembelian paket langganan LuxTrade bersifat FINAL dan TIDAK DAPAT dikembalikan (non-refundable).</strong> <!-- -->Layanan kami adalah produk digital berupa akses perangkat lunak yang diaktifkan secara otomatis setelah pembayaran berhasil. Karena sifat digital yang tidak dapat dikembalikan, kami tidak memberikan pengembalian dana (refund) setelah fitur premium diakses dan digunakan.</p><p class=\"text-white/60 text-sm mt-3\">Pengecualian: Pengembalian dana hanya dapat diproses jika terjadi pembayaran ganda (double charge) atau kesalahan teknis dari pihak payment gateway yang terverifikasi.</p></div></div></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">6. Kepemilikan Intelektual</h2><p class=\"text-white/70 leading-relaxed\">Semua konten, fitur, dan fungsionalitas LuxTrade adalah milik LuxTrade dan dilindungi oleh hukum hak cipta internasional. Data trading yang Anda input tetap menjadi milik Anda.</p></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">7. Batasan Tanggung Jawab</h2><div class=\"bg-red-500/10 border border-red-500/20 rounded-xl p-5\"><p class=\"text-white/70 leading-relaxed\"><strong class=\"text-red-400\">Penting:</strong> LuxTrade adalah platform perangkat lunak (SaaS), BUKAN platform trading, broker, pialang, atau saran investasi. Keputusan trading sepenuhnya tanggung jawab pengguna. Kami tidak bertanggung jawab atas kerugian finansial yang mungkin terjadi dari aktivitas trading pengguna. Selengkapnya baca halaman<!-- --> <a class=\"text-cyan-400 underline hover:text-cyan-300\" href=\"/disclaimer\">Disclaimer</a>.</p></div></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">8. Penolakan Jaminan</h2><p class=\"text-white/70 leading-relaxed\">Layanan disediakan &quot;sebagaimana adanya&quot; tanpa jaminan apapun. Kami tidak menjamin bahwa layanan akan bebas dari error, aman, atau tersedia tanpa gangguan.</p></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">9. Penghentian Layanan</h2><p class=\"text-white/70 leading-relaxed\">Kami berhak untuk menangguhkan atau menghentikan akun Anda jika melanggar ketentuan ini. Kami juga dapat menghentikan layanan secara keseluruhan dengan pemberitahuan 30 hari.</p></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">10. Perubahan Ketentuan</h2><p class=\"text-white/70 leading-relaxed\">Kami dapat mengubah ketentuan ini sewaktu-waktu. Perubahan akan diberitahukan melalui email atau notifikasi di platform. Penggunaan berlanjut setelah perubahan berarti Anda menyetujui ketentuan baru.</p></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">11. Hukum yang Berlaku</h2><p class=\"text-white/70 leading-relaxed\">Ketentuan ini diatur oleh dan ditafsirkan sesuai dengan hukum Republik Indonesia. Sengketa akan diselesaikan melalui arbitrase di Jakarta.</p></section><section><h2 class=\"text-2xl font-semibold text-white mb-4\">12. Hubungi Kami</h2><p class=\"text-white/70 leading-relaxed\">Jika Anda memiliki pertanyaan tentang Ketentuan Layanan ini, silakan hubungi kami di:</p><div class=\"bg-white/[0.02] border border-white/5 rounded-xl p-5 mt-4 space-y-2\"><p class=\"text-white/70\"><strong class=\"text-cyan-400\">Nama Usaha:</strong> LuxTrade</p><p class=\"text-white/70\"><strong class=\"text-cyan-400\">Email:</strong> luxtradee@gmail.com</p><p class=\"text-white/70\"><strong class=\"text-cyan-400\">Telepon:</strong> +62 857-1205-4394</p><p class=\"text-white/70\"><strong class=\"text-cyan-400\">Alamat Usaha:</strong> Jakarta, Indonesia</p><p class=\"text-white/70\"><strong class=\"text-cyan-400\">Website:</strong> luxtradee.web.id</p></div></section></div></div></main><footer class=\"border-t border-white/5 py-8 mt-12\"><div class=\"max-w-4xl mx-auto px-4 text-center text-white/40 text-sm\"><p>© <!-- -->2026<!-- --> LuxTrade. All rights reserved.</p><div class=\"flex justify-center gap-4 mt-4 flex-wrap\"><a class=\"hover:text-white transition-colors\" href=\"/disclaimer\">Disclaimer</a><a class=\"hover:text-white transition-colors\" href=\"/privacy\">Privacy Policy</a><a class=\"hover:text-white transition-colors\" href=\"/terms\">Terms of Service</a><a class=\"hover:text-white transition-colors\" href=\"/refund-policy\">Refund Policy</a><a class=\"hover:text-white transition-colors\" href=\"/faq\">FAQ</a><a class=\"hover:text-white transition-colors\" href=\"/contact\">Kontak</a></div></div></footer></div><!--$--><!--/$--><!--/$--><section aria-label=\"Notifications alt+T\" tabindex=\"-1\" aria-live=\"polite\" aria-relevant=\"additions text\" aria-atomic=\"false\"></section><script src=\"/_ne